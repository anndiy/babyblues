PORT=3000
NODE_ENV=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3-flash-preview
CORS_ORIGINS=

# Only required by scripts/seed-demo-data.js. Never expose this key to a client.
# Use a dedicated Supabase Auth user created specifically for demo data.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
DEMO_USER_ID=UUID_OF_DEDICATED_DEMO_AUTH_USER
# Must match the demo user's email in Supabase Auth; the seeder refuses to run otherwise.
DEMO_USER_EMAIL=demo-account-email@example.com
# Required explicit confirmation because the seeder replaces this user's demo rows.
DEMO_SEED_ALLOW_DELETIONS=false
